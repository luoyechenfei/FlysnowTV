<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 电视盒子没有触摸屏，这两项声明避免被应用市场/系统误过滤 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Android 11+ 包可见性：允许检测并拉起第三方播放器与央视频 TV 版 -->
    <queries>
        <package android:name="com.newtv.cboxtv" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="org.xbmc.kodi" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvIptv"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <!-- 电视桌面入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 支持 adb 直接传入播放列表地址：am start -a android.intent.action.VIEW -d "http://x/list.m3u" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:pathPattern=".*\\.m3u" />
                <data android:scheme="https" android:host="*" android:pathPattern=".*\\.m3u" />
                <data android:scheme="http" android:host="*" android:pathPattern=".*\\.m3u8" />
                <data android:scheme="https" android:host="*" android:pathPattern=".*\\.m3u8" />
                <data android:scheme="http" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:scheme="https" android:host="*" android:pathPattern=".*\\.txt" />
            </intent-filter>

            <!-- 任意聚合订阅地址的一键导入深链（包括没有扩展名的接口） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flysnow" android:host="import" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".QrConfigActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".EpgGridActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:exported="false" />
    </application>

</manifest>
