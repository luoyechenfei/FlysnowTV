<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="132dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 统一台标玻璃板：网络台标、内置台标、首字母占位都收进同一块圆角底板，
         固定尺寸 + 固定内边距 + 等比居中，保证不同来源台标大小、位置、底色协调一致。 -->
    <FrameLayout
        android:id="@+id/logoPlate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/bg_logo_plate">

        <!-- 无台标时的占位首字 -->
        <TextView
            android:id="@+id/channelLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#B6CCEF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- 台标专用 LogoFitView（1.9.9：圆角已恢复原样、不裁剪）：
             MATRIX 等比缩放按图片真实尺寸计算，显示尺寸永远 ≤ 本框 78%（放大封顶 2 倍），
             任何来源的台标都完整显示、不溢出台标槽，也不依赖任何外部时序。 -->
        <com.iptv.tvplayer.LogoFitView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:padding="6dp" />
    </FrameLayout>

    <!-- 预览小窗占位：整个列表只创建一个 PlayerView，聚焦时动态挂到这里。
         每张卡片都放 TextureView 会在低端盒子上拖垮 SurfaceFlinger / GPU。 -->
    <FrameLayout
        android:id="@+id/previewHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="50dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:shadowColor="#22000A1E"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2.5"
        android:textColor="#EAF1FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/officialTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_official_tag"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="官方入口"
        android:textColor="#AFCBFF"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/selectBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_select_badge_empty"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:text="○ 选择"
        android:textColor="#D8E8FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/favoriteTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_fav_tag"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="★"
        android:textColor="#FFC46B"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/previewTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/bg_preview_tag"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="● 预览 · 静音"
        android:textColor="#BFD3FF"
        android:textSize="9sp"
        android:visibility="gone" />

    <View
        android:id="@+id/nowDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/dot_live"
        android:visibility="gone" />

</FrameLayout>
