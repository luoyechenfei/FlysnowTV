<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ 底层：全屏播放画面 ============ -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/loadingView"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_overlay"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxWidth="580dp"
        android:padding="26dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 播放态：左上角「正在播放」信息卡。
         与右上角换台信息卡共用 bg_info_card、等宽等高、同一顶部边距，保证左右对齐。 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="340dp"
        android:layout_height="184dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="40dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_info_card"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在播放"
            android:textColor="#8FB2FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/playbackStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFC46B"
            android:textSize="12sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2C3D5C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="OK 节目单　←→ 切换线路　BACK 频道墙"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_overlay"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:text="OK 节目单　GUIDE 时间轴　←→ 切线路　快退键 回看/时移　BACK 频道墙　MENU 设置"
        android:textColor="#C1CFE8"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- ============ 上层：频道海报墙 ============ -->
    <LinearLayout
        android:id="@+id/wallLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wall"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="30dp"
        android:paddingEnd="44dp"
        android:paddingBottom="16dp">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 品牌标记：纯白雪花，不含任何文字 -->
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_snowflake" />

            <TextView
                android:id="@+id/countView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="0 个频道"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/nowPlayingChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_live"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="320dp"
                android:paddingStart="15dp"
                android:paddingTop="8dp"
                android:paddingEnd="17dp"
                android:paddingBottom="8dp"
                android:textColor="#AFCBFF"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sourceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="middle"
                android:maxWidth="230dp"
                android:singleLine="true"
                android:text="未设置播放源"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_settings_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingTop="9dp"
                android:paddingEnd="22dp"
                android:paddingBottom="9dp"
                android:text="@string/action_settings"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guideButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_settings_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingTop="9dp"
                android:paddingEnd="22dp"
                android:paddingBottom="9dp"
                android:text="GUIDE 节目单"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 分组筛选 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groupList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- 海报墙 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="还没有频道　按 MENU 或点右上角「设置」添加播放源"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wallHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="OK 播放　·　长按 OK 收藏　·　CH+/CH- 换台　·　数字键直选　·　MENU 设置中心"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 换台时右上角频道信息卡：与左上「正在播放」等宽等高、同一顶部边距，
         共用 bg_info_card 背景与描边，内部字号/行距也统一，保证左右对齐协调。 -->
    <LinearLayout
        android:id="@+id/channelInfoCard"
        android:layout_width="340dp"
        android:layout_height="184dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_info_card"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8FB2FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/infoProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="#C9D8F5"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/infoExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/infoTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A06BFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 节目预约提醒：开播前 1 分钟弹出，按 OK 立即跳台 -->
    <TextView
        android:id="@+id/reservationCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_overlay"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingTop="14dp"
        android:paddingEnd="26dp"
        android:paddingBottom="14dp"
        android:textColor="#FFC46B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 播放态按 OK 呼出的左侧节目单 -->
    <LinearLayout
        android:id="@+id/epgPanel"
        android:layout_width="366dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_epg_panel"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/epgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="节目单"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/epgTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="#8FB2FF"
            android:textSize="11.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epgList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/epgDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_overlay"
            android:lineSpacingExtra="3dp"
            android:maxLines="7"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="#C9D8F5"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="↑↓ 选台　OK 播放　MENU 收藏　BACK 收起"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

</FrameLayout>
