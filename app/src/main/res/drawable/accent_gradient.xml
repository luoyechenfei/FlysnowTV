<?xml version="1.0" encoding="utf-8"?>
<!-- 1.9.6：强调色按钮也统一为液态玻璃，加镜面反光与顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#4FC3F0"
                android:startColor="#5B9BFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#4DFFFFFF"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
