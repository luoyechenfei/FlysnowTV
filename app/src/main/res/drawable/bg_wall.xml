<?xml version="1.0" encoding="utf-8"?>
<!-- 频道墙主背景：自上而下的主流深蓝渐变，顶部保留一道蓝色光晕，避免整体发黑 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#103474"
        android:endColor="#0B2658"
        android:startColor="#1D58A6"
        android:type="linear" />
</shape>
