<?xml version="1.0" encoding="utf-8"?>
<!-- 手动 MENU 模式下「当前选中功能」：与全局芯片边框统一——
     2dp 亮蓝白描边 #BFE6FF + 更亮玻璃面 + 柔和外发光（小圆角版）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和外发光 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E8FD6FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 更亮玻璃面 + 亮蓝白描边 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#B41E5FA6"
                android:startColor="#D64A9BD6"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#BFE6FF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <!-- 顶部镜面高光 -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF"
                android:type="linear" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
