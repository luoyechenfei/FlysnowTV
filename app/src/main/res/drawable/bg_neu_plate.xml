<?xml version="1.0" encoding="utf-8"?>
<!-- 大面板（信息卡 / 底部信息栏 / 数字选台卡 / 对话框 / 提示条）：
     加厚的液态玻璃，六层结构，仍保持足够透明度以透出直播画面。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="3dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/glass_plate_mid"
                android:endColor="@color/glass_plate_bottom"
                android:startColor="@color/glass_plate_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/glass_rim" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/glass_rim_inner" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#1CFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="@color/glass_inner_shadow"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
