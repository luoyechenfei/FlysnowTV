<?xml version="1.0" encoding="utf-8"?>
<!-- 大面板（信息卡 / 底部信息栏 / 数字选台卡）：半透明磨砂玻璃 + 柔光拟态。
     保持能透出直播画面，同时有「浮在画面之上」的立体层次。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D000F2C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/neu_plate_bottom"
                android:startColor="@color/neu_plate_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/neu_stroke" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
