<?xml version="1.0" encoding="utf-8"?>
<!-- 内凹玻璃槽：台标底板 / 输入框。顶部内阴影 + 底部反光边，
     形成「嵌进玻璃里」的折射感，而不是简单压暗一块颜色。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#CC174080"
                android:endColor="#D61B488C"
                android:startColor="#D6123672"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#335FA8D8" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#59001030"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#2E8FB2FF"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
