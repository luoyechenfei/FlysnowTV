<?xml version="1.0" encoding="utf-8"?>
<!-- 按下 / 内凹态：主体压暗、顶边压暗、底边微亮，玻璃被「按进去」 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#CC143876"
                android:endColor="#CC1B488C"
                android:startColor="#CC0C2C5C"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#335FA8D8" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="@color/glass_inner_shadow"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
