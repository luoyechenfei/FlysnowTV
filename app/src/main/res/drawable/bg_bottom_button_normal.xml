<?xml version="1.0" encoding="utf-8"?>
<!-- 底部信息栏操作按钮：小圆角液态玻璃，半透明可透出直播画面（默认态） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#962A5BA4"
                android:endColor="#801A4278"
                android:startColor="#B33A6CB0"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#4D7FA6FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#1CFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#30FFFFFF"
                android:type="linear" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
