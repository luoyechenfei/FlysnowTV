<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 焦点：发光描边 + 提亮渐变 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#182238"
                android:startColor="#293B5C"
                android:type="linear" />
            <stroke android:width="2.5dp" android:color="#8FB2FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- 正在播放：蓝色细边 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#131B2A"
                android:startColor="#1C2A44"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#665B8DFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#111824"
                android:startColor="#1C2637"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#26334A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
