<?xml version="1.0" encoding="utf-8"?>
<!-- 「正在播放」小标签：薄玻璃胶囊，顶部高光 + 单色细边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#4D123970"
                android:startColor="#662C64B0"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#805B9BFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF"
                android:type="linear" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
