     常态一种静蓝边框，聚焦 / 按下 / 选中时边框变色为亮蓝白，好区分。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_setting_focused" android:state_pressed="true" />
