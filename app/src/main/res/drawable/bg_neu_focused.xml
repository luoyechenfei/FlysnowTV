<?xml version="1.0" encoding="utf-8"?>
<!-- 遥控器聚焦态：面提亮 + 一圈柔光描边，仍然保持半透明 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D91E4C96"
                android:startColor="#F03A78D0"
                android:type="linear" />
            <stroke android:width="2dp" android:color="@color/neu_stroke_focus" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#30FFFFFF"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
