<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部频道计数：薄玻璃胶囊，顶部高光 + 冷色细边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#122A5BA8"
                android:startColor="#2AFFFFFF"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#4AA8D8FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#2EFFFFFF"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
