<?xml version="1.0" encoding="utf-8"?>
<!-- 在线更新的水平进度条：深蓝轨道 + 宝蓝进度，和拟态深蓝主题一致 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dim" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/neu_stroke" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/accent_2"
                    android:startColor="@color/accent"
                    android:type="linear" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
