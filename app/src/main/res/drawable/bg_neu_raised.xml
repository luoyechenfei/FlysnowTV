<?xml version="1.0" encoding="utf-8"?>
<!-- 柔光拟态「凸起」面：底部柔和暗影 + 半透明主体 + 顶部一道高光。
     不用 elevation / outlineProvider，避免老盒子 GPU 额外负担。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/neu_face_bottom"
                android:startColor="@color/neu_face_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/neu_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/neu_highlight"
                android:type="linear" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
