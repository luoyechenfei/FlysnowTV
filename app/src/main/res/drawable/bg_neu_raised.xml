<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃「凸起」面：落影 + 半透明折射主体 + 色散内边 + 斜向镜面 + 顶部高光。
     不使用 elevation / RenderEffect（后者需 API 31），老盒子也能稳定绘制。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/glass_body_mid"
                android:endColor="@color/glass_body_bottom"
                android:startColor="@color/glass_body_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/glass_rim" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/glass_rim_inner" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#1CFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
