<?xml version="1.0" encoding="utf-8"?>
<!-- 左上「正在播放」与右上「换台信息」共用的信息卡底板：
     同一份渐变、圆角、描边，保证左右两张卡视觉完全一致。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#131C2C"
        android:startColor="#1D2B45"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#33486B" />
    <corners android:radius="18dp" />
    <padding
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp" />
</shape>
