<?xml version="1.0" encoding="utf-8"?>
<!-- 设置项 / 按钮「聚焦 / 选中」：边框变色为亮蓝白 #BFE6FF + 更亮玻璃面 +
     柔和外发光，让遥控器光标落点一目了然，与常态静蓝边框明显区分。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光：略大于主体的柔光，提示选中 -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#2E66B6FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 主体：亮蓝玻璃 + 变色描边 -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#5A3F86DC"
                android:endColor="#462E6FC0"
                android:startColor="#6E5AA0EE"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#BFE6FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
