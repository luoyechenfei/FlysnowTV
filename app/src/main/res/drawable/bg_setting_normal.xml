<?xml version="1.0" encoding="utf-8"?>
<!-- 设置项 / 按钮「常态」：一种固定边框色（静蓝 #4D7FA6FF）+ 极淡玻璃填充，
     与聚焦态的变色边框形成清晰区分，符合「菜单键」轻量边框风格。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E1A3A66" />
            <stroke
                android:width="1dp"
                android:color="#4D7FA6FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 顶部淡高光，呼应卡片镜面反光 -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#18FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
