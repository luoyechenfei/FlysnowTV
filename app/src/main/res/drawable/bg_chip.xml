<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#A06BFF"
                android:startColor="#4C86FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#223558" />
            <stroke android:width="1.5dp" android:color="#7FA6FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141C2A" />
            <stroke android:width="1dp" android:color="#27334A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
