<?xml version="1.0" encoding="utf-8"?>
<!-- 多选已勾选：亮蓝玻璃 + 白描边 + 镜面反光，与聚焦态 / 正在播放态区分 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#403D7BF0" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#B53C7ACC"
                android:endColor="#A6235CA8"
                android:startColor="#B2508CD8"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#26FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
